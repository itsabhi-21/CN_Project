#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"
FIRST_LINE="$(head -n 1 "$MSG_FILE")"

# Allow merge and revert commits generated by git
if [[ "$FIRST_LINE" =~ ^(Merge|Revert)\  ]]; then
  exit 0
fi

PATTERN='^(feat|fix|docs|test|refactor|chore|ci|build)(\([a-zA-Z0-9._-]+\))?(!)?: .{3,}$'

if [[ ! "$FIRST_LINE" =~ $PATTERN ]]; then
  echo "ERROR: Commit message does not follow Conventional Commits:" >&2
  echo "  $FIRST_LINE" >&2
  echo "Expected format: <type>(<optional-scope>): <summary>" >&2
  echo "Allowed types: feat, fix, docs, test, refactor, chore, ci, build" >&2
  exit 1
fi
